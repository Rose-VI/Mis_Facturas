<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppFactura.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AppFactura.ViewModels"
    x:DataType="vm:MainViewModel"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" Padding="20,18,12,12" BackgroundColor="{StaticResource Primary}" ColumnDefinitions="*,Auto,Auto">
            <VerticalStackLayout VerticalOptions="Center">
                <Label Text="{Binding PageTitle}" FontSize="25" FontFamily="OpenSansSemibold" TextColor="White" />
                <Label Text="{Binding ResultCount, StringFormat='{0} resultados'}" FontSize="12" TextColor="#DCE7E8" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="☆" FontSize="24" BackgroundColor="Transparent"
                    Command="{Binding ShowFavoritesCommand}" SemanticProperties.Description="Ver favoritos" />
            <Button Grid.Column="2" Text="☰" FontSize="22" BackgroundColor="Transparent"
                    Command="{Binding ToggleFiltersCommand}" SemanticProperties.Description="Abrir filtros" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Padding="14,10" Spacing="8">
            <SearchBar Placeholder="Buscar por título o memorándum"
                       Text="{Binding SearchText, Mode=TwoWay}" />
            <Border IsVisible="{Binding IsFilterPanelVisible}" Padding="14" BackgroundColor="White"
                    Stroke="{StaticResource Gray200}" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Filtrar por rango de fechas" VerticalOptions="Center" FontFamily="OpenSansSemibold" />
                        <Switch Grid.Column="1" IsToggled="{Binding UseDateFilter}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsEnabled="{Binding UseDateFilter}">
                        <VerticalStackLayout>
                            <Label Text="Desde" FontSize="12" TextColor="{StaticResource MutedText}" />
                            <DatePicker Date="{Binding FromDate}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Hasta" FontSize="12" TextColor="{StaticResource MutedText}" />
                            <DatePicker Date="{Binding ToDate}" />
                        </VerticalStackLayout>
                    </Grid>
                    <HorizontalStackLayout HorizontalOptions="End">
                        <Button Text="Limpiar" BackgroundColor="{StaticResource Gray500}" Command="{Binding ClearFiltersCommand}" />
                        <Button Text="Aplicar" Command="{Binding ApplyFiltersCommand}" />
                    </HorizontalStackLayout>
                    <Label Text="Los datos se guardan solo en este dispositivo y se eliminan al desinstalar la aplicación."
                           FontSize="11" TextColor="{StaticResource MutedText}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="2">
            <CollectionView ItemsSource="{Binding Groups}" IsGrouped="True" Margin="14,0,14,12"
                            IsVisible="{Binding HasResults}">
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:InvoiceDayGroup">
                        <Grid Padding="6,14,6,8" ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource PageBackground}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout>
                                <Label Text="{Binding DisplayDate}" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding TotalCount, StringFormat='{0} facturas'}" FontSize="11" TextColor="{StaticResource MutedText}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding Arrow}" FontSize="28" VerticalOptions="Center" TextColor="{StaticResource Primary}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:InvoiceCardViewModel">
                        <Border Margin="0,0,0,9" Padding="10" BackgroundColor="White"
                                StrokeThickness="0" StrokeShape="RoundRectangle 14">
                            <Border.Shadow>
                                <Shadow Brush="#25000000" Offset="0,2" Radius="6" Opacity="0.25" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="68,*,Auto" ColumnSpacing="12">
                                <Border HeightRequest="62" WidthRequest="68" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{StaticResource Secondary}">
                                    <Image Source="{Binding ThumbnailPath}" Aspect="AspectFill" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                    <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="16" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding TimeText}" FontSize="13" TextColor="{StaticResource MutedText}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="{Binding FavoriteIcon}" FontSize="24" TextColor="{StaticResource Tertiary}"
                                        BackgroundColor="Transparent" Command="{Binding ToggleFavoriteCommand}" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout IsVisible="{Binding HasNoResults}" HorizontalOptions="Center"
                                 VerticalOptions="Center" Spacing="10" Padding="32">
                <Label Text="▤" FontSize="50" HorizontalTextAlignment="Center" TextColor="{StaticResource Gray400}" />
                <Label Text="{Binding EmptyMessage}" FontSize="17" HorizontalTextAlignment="Center"
                       TextColor="{StaticResource MutedText}" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="3" Padding="16,0,16,14">
            <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Danger}" FontSize="12" />
        </Grid>

        <Button Grid.RowSpan="4" Text="+" FontSize="30" WidthRequest="58" HeightRequest="58"
                Padding="0" CornerRadius="29" HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,20,24" Command="{Binding AddCommand}" SemanticProperties.Description="Agregar factura">
            <Button.Shadow>
                <Shadow Brush="#50000000" Offset="0,4" Radius="8" Opacity="0.4" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>
